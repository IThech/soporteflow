# SoporteFlow — Variables de entorno del servidor (ejemplo)
# IMPORTANTE: Nunca incluyas credenciales reales en este archivo ni en el control de versiones.

# Cadena de conexión PostgreSQL (exclusiva del servidor)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/soporteflow

# Fase A: construcción privada opcional; no habilita endpoints ni login.
BETTER_AUTH_ENABLED=false
# Generar un secreto aleatorio de al menos 32 caracteres fuera del repositorio.
BETTER_AUTH_SECRET=
# Origen exacto HTTPS, sin ruta, credenciales, query ni fragmento.
# HTTP en localhost solo durante desarrollo local.
BETTER_AUTH_URL=

# 5.4V-B: clave AES-256-GCM para cifrar los secretos de firma de webhooks (32 bytes en hex o
# base64). Generar fuera del repositorio, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin esta clave no se pueden crear webhooks y las entregas pendientes reintentan con CONFIGURATION_ERROR.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# 5.4W-E: nivel del log estructurado (JSON por línea): debug | info | warn | error | silent.
# No es un secreto. Por defecto info. Los tests lo fijan en silent.
LOG_LEVEL=info

# 5.4X-C: clave AES-256-GCM del outbox de invitaciones (token de un solo uso cifrado en reposo).
# 32 bytes en hex (64 caracteres) o base64, INDEPENDIENTE de WEBHOOK_SECRET_ENCRYPTION_KEY.
# Obligatoria en producción con BETTER_AUTH_ENABLED=true. Sin ella no se pueden emitir invitaciones (503).
INVITATION_TOKEN_ENCRYPTION_KEY=

# 5.4X-D: retención operacional opcional (días, 1..3650). Sin valor = no se purga nada.
# El registro de auditoría administrativa nunca se purga con estas variables.
RETENTION_NOTIFICATION_DELIVERIES_DAYS=
RETENTION_WEBHOOK_DELIVERIES_DAYS=
RETENTION_INVITATION_DELIVERIES_DAYS=
RETENTION_AUTOMATION_EXECUTIONS_DAYS=

# 5.4X-D: límites técnicos por organización (solo pueden BAJAR el techo técnico de 100).
QUOTA_MAX_ACTIVE_WEBHOOKS=
QUOTA_MAX_ACTIVE_AUTOMATION_RULES=

# Adjuntos V1: directorio privado absoluto FUERA del repositorio/static, solo DEV.
# Sin configurar o en producción: subida y descarga responden 503. No contiene secretos.
ATTACHMENT_DEV_ROOT=
